/* Lets implement a simple security FS using a directory KEY */
/* A secret KEY is known only to the specific USERS. And this KEY used for listing directory */
/* Inside any directory of this FS files will be listed only if dirname.KEY file would available */
/* Compile: cc keyfs.c `pkg-config fuse3 --cflags --libs` -o keyfs */
/* Usage: mkdir /tmp/mountpoint; ./keyfs /tmp/mountpoint;ls /tmp/mountpoint/this_dir;touch /tmp/backing/this_dir/this_dir.KEY;ls /tmp/mountpoint/this_dir */

#define FUSE_USE_VERSION 31
#include <fuse.h>
#include <stdio.h>
#include <string.h>
#include <dirent.h>
#include <errno.h>
#include <libgen.h>
#include <unistd.h>
#include <limits.h>

// Change this to your backing store root directory
static const char *rootdir = "/tmp/myroot";

static void build_full_path(char fpath[PATH_MAX], const char *path)
{
    snprintf(fpath, PATH_MAX, "%s%s", rootdir, path);
}

// Check if <dirname>.KEY exists inside directory
static int key_exists(const char *dirpath)
{
    char fpath[PATH_MAX];
    char temp[PATH_MAX];

    strcpy(temp, dirpath);
    char *dir_name = basename(temp);

    snprintf(fpath, PATH_MAX, "%s/%s.KEY", dirpath, dir_name);

    return access(fpath, F_OK) == 0;
}

static int myfs_readdir(const char *path, void *buf, fuse_fill_dir_t filler,
                       off_t offset, struct fuse_file_info *fi,
                       enum fuse_readdir_flags flags)
{
    DIR *dp;
    struct dirent *de;

    char fpath[PATH_MAX];
    build_full_path(fpath, path);

    // Always allow root directory
    if (strcmp(path, "/") != 0)
    {
        if (!key_exists(fpath))
        {
            // Return empty directory (hide contents)
            filler(buf, ".", NULL, 0, 0);
            filler(buf, "..", NULL, 0, 0);
            return 0;
        }
    }

    dp = opendir(fpath);
    if (dp == NULL)
        return -errno;

    // Add default entries
    filler(buf, ".", NULL, 0, 0);
    filler(buf, "..", NULL, 0, 0);

    while ((de = readdir(dp)) != NULL)
    {
        // Skip . and ..
        if (strcmp(de->d_name, ".") == 0 ||
            strcmp(de->d_name, "..") == 0)
            continue;

        filler(buf, de->d_name, NULL, 0, 0);
    }

    closedir(dp);
    return 0;
}

static int myfs_getattr(const char *path, struct stat *stbuf,
                       struct fuse_file_info *fi)
{
    char fpath[PATH_MAX];
    build_full_path(fpath, path);

    int res = lstat(fpath, stbuf);
    if (res == -1)
        return -errno;

    return 0;
}

// Minimal operations struct
static struct fuse_operations myfs_oper = {
    .readdir = myfs_readdir,
    .getattr = myfs_getattr,
};

int main(int argc, char *argv[])
{
    return fuse_main(argc, argv, &myfs_oper, NULL);
}
